# Required for general-knowledge answers and policy responses that need generation.
# Safe greetings and local conflict/uncertainty checks can run without this key.
GEMINI_API_KEY=
# Uses the Gemini API model endpoint; override only with a supported model name.
GEMINI_MODEL=gemini-3.8-flash
# Optional frontend API override (default: http://localhost:8000).
VITE_API_URL=http://localhost:8000

# Firebase Web app configuration (Firebase Console > Project settings > General).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=

# Optional. Set this to a Firebase service-account JSON path for Firebase-wide token revocation.
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_PATH=
# Comma-separated addresses allowed to upload policy documents.
FIREBASE_ADMIN_EMAILS=
# Comma-separated exact browser origins. Do not use a wildcard in production.
CAMPUSANSWER_CORS_ORIGINS=http://localhost:5175
# Free production persistence (server-side service-role key; never put this in Vite variables).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=campusanswer-documents
# Keep false for local development; Render Free deployment requires Supabase.
CAMPUSANSWER_REQUIRE_CLOUD_STORAGE=false
# Optional local-only storage paths; production uses Supabase instead.
CAMPUSANSWER_AUTH_DATABASE=
CAMPUSANSWER_PROFILE_DATABASE=
CAMPUSANSWER_DOCUMENTS_DIR=
